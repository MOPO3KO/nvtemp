#!/usr/bin/env python3
"""Stub nvidia-smi that reports long, realistic card names.

Used to check that the summary columns line up when "Device N [name]" labels are
much wider than the fake "Fake GPU" names. Set FAKE_NAMES to a comma-separated
list to override the defaults.

All other behaviour matches tests/fake_smi/nvidia-smi.
"""
import os
import sys

# One short name and two long ones: the summary columns must follow the longest.
default_names = ["A100", "Tesla V100-SXM2-32GB", "NVIDIA GeForce RTX 4090"]
names = os.environ.get("FAKE_NAMES")
names = [n.strip() for n in names.split(",")] if names else default_names
gpus = int(os.environ.get("FAKE_GPUS", str(len(names))))
names = (names * gpus)[:gpus]

query = ""
for arg in sys.argv[1:]:
    if arg.startswith("--query-gpu="):
        query = arg.split("=", 1)[1]

fields = query.split(",")
if fields == ["index", "name"]:
    for i in range(gpus):
        print(f"{i}, {names[i]}")
elif fields == ["index", "temperature.gpu", "temperature.slow_threshold"]:
    for i in range(gpus):
        print(f"{i}, 72, 90")
elif fields == ["index", "temperature.gpu", "temperature.memory"]:
    for i in range(gpus):
        print(f"{i}, 72, 58")
elif fields == ["index", "temperature.gpu", "temperature.memory",
                "utilization.gpu", "memory.used", "memory.total"]:
    for i in range(gpus):
        print(f"{i}, 72, 58, 87, 19456, 24576")
else:
    sys.stderr.write(f"fake nvidia-smi: unsupported query {query!r}\n")
    sys.exit(1)
